package com.example.semiautomatedlims.Controller;

import com.example.semiautomatedlims.Entity.ChemData;
import com.example.semiautomatedlims.Service.ChemDataService;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.*;

import java.util.List;

@RestController
@RequestMapping("/api/chemdata")
public class ChemDataController {

    @Autowired
    private ChemDataService chemDataService;

    // Endpoint to get all chem_data records
    @GetMapping("/all")
    public List<ChemData> getAllChemData() {
        return chemDataService.getAllChemData();
    }

    // Endpoint to get chem_data records by analyte
    @GetMapping("/analyte/{analyte}")
    public List<ChemData> getChemDataByAnalyte(@PathVariable String analyte) {
        return chemDataService.getChemDataByAnalyte(analyte);
    }
}
