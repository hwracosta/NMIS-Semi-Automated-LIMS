package com.example.semiautomatedlims.Service;

import com.example.semiautomatedlims.Entity.ChemData;
import com.example.semiautomatedlims.Repository.ChemDataRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import java.util.List;

@Service
public class ChemDataService {

    private final ChemDataRepository chemDataRepository;

    @Autowired
    public ChemDataService(ChemDataRepository chemDataRepository) {
        this.chemDataRepository = chemDataRepository;
    }

    public List<ChemData> getAllChemicalTests() {
        return chemDataRepository.findAll();
    }

    public Integer getTotalTests() {
        return chemDataRepository.countTotalTests();
    }

    public Integer getPositiveResults() {
        return chemDataRepository.countPositiveResults();
    }

    public Integer getNegativeResults() {
        return chemDataRepository.countNegativeResults();
    }

    public List<ChemData> findByAnalyte(String analyte) {
        return chemDataRepository.findByAnalyte(analyte);
    }
}

